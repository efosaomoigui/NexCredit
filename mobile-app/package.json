{
  "name": "mobile-app",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "kill": "node scripts/free-port.js 9000",
    "clean:expo": "node scripts/clean-expo-cache.js",
    "start": "expo start --offline --port 9000",
    "start:clean": "node scripts/clean-expo-cache.js && expo start --offline --port 9000 --clear",
    "android": "expo start --offline --port 9000 --android",
    "ios": "expo start --offline --port 9000 --ios",
    "web": "expo start --offline --port 9000 --web"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/dm-serif-display": "^0.4.2",
