# =============================================================================
# NexCredit — Environment Variable Template
# =============================================================================
# Copy this file to .env and fill in real values for local development.
# NEVER commit .env to version control. Only .env.example is committed.
# Production secrets are managed via GCP Secret Manager.
# =============================================================================

# -----------------------------------------------------------------------------
# Application Config
# -----------------------------------------------------------------------------
ENVIRONMENT=development                      # One of: development | staging | production
DEBUG=true                                   # Enable debug mode (set false in production)
LOG_LEVEL=INFO                               # Logging verbosity: DEBUG | INFO | WARNING | ERROR
ALLOWED_ORIGINS=http://localhost:6100,http://localhost:3001  # Comma-separated CORS origins

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://nexcredit:changeme@localhost:5433/lending_dev
# Async SQLAlchemy connection string for PostgreSQL 15.
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>

DATABASE_POOL_SIZE=10                        # SQLAlchemy connection pool size
DATABASE_MAX_OVERFLOW=20                     # Max connections above pool size

# -----------------------------------------------------------------------------
# Redis / Celery
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# Redis connection string used for both caching and Celery task queue.

CELERY_BROKER_URL=redis://localhost:6379/1  # Celery broker (separate DB index from cache)
CELERY_RESULT_BACKEND=redis://localhost:6379/2  # Celery result backend

# -----------------------------------------------------------------------------
# JWT (RS256 — Asymmetric Keys)
# -----------------------------------------------------------------------------
JWT_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nREPLACE_WITH_YOUR_PRIVATE_KEY\n-----END RSA PRIVATE KEY-----
# RSA-2048 private key used to sign JWTs. Generate with:
#   openssl genrsa -out private.pem 2048

JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nREPLACE_WITH_YOUR_PUBLIC_KEY\n-----END PUBLIC KEY-----
# RSA-2048 public key used to verify JWTs. Extract with:
#   openssl rsa -in private.pem -pubout -out public.pem

# Dev-friendly JWT config (HS256). For production, prefer RS256 keys above.
JWT_ALGORITHM=HS256
JWT_SECRET=dev_only_change_me

ACCESS_TOKEN_TTL=900          # Access token lifetime in seconds (default: 15 minutes)
REFRESH_TOKEN_TTL=604800      # Refresh token lifetime in seconds (default: 7 days)

# -----------------------------------------------------------------------------
# Paystack — Repayment Collection
# -----------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=sk_test_REPLACE_WITH_PAYSTACK_SECRET_KEY
# Server-side secret key from Paystack Dashboard → Settings → API Keys.

PAYSTACK_PUBLIC_KEY=pk_test_REPLACE_WITH_PAYSTACK_PUBLIC_KEY
# Client-side public key for Paystack inline popup.

PAYSTACK_WEBHOOK_SECRET=REPLACE_WITH_PAYSTACK_WEBHOOK_SECRET
# Webhook signing secret for validating incoming Paystack event payloads.

# -----------------------------------------------------------------------------
# Flutterwave — Loan Disbursement
# -----------------------------------------------------------------------------
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-REPLACE_WITH_FLUTTERWAVE_SECRET
# Flutterwave secret key from Dashboard → Settings → API.

FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-REPLACE_WITH_FLUTTERWAVE_PUBLIC
# Flutterwave public key for client-side SDK initialisation.

FLUTTERWAVE_ENCRYPTION_KEY=REPLACE_WITH_FLUTTERWAVE_ENCRYPTION_KEY
# 3DES encryption key provided by Flutterwave for payload encryption.

FLUTTERWAVE_WEBHOOK_SECRET=REPLACE_WITH_FLUTTERWAVE_WEBHOOK_HASH
# Hash secret for verifying Flutterwave webhook event authenticity.

# -----------------------------------------------------------------------------
# Monnify — Virtual Accounts
# -----------------------------------------------------------------------------
MONNIFY_API_KEY=REPLACE_WITH_MONNIFY_API_KEY
# Monnify API key from the Merchant Dashboard.

MONNIFY_SECRET_KEY=REPLACE_WITH_MONNIFY_SECRET_KEY
# Monnify secret key used for server-side authentication.

MONNIFY_CONTRACT_CODE=REPLACE_WITH_MONNIFY_CONTRACT_CODE
# Monnify contract code identifying your merchant account for virtual account creation.

MONNIFY_BASE_URL=https://sandbox.monnify.com
# Monnify base URL. Use https://api.monnify.com for production.

MONNIFY_WEBHOOK_SECRET=REPLACE_WITH_MONNIFY_WEBHOOK_SECRET
# Shared secret for verifying Monnify webhook event signatures.

# -----------------------------------------------------------------------------
# Mono — Open Banking / Bank Statement Analysis
# -----------------------------------------------------------------------------
MONO_SECRET_KEY=REPLACE_WITH_MONO_SECRET_KEY
# Mono secret key for server-side API calls (account linking, statement fetch).

MONO_WEBHOOK_SECRET=REPLACE_WITH_MONO_WEBHOOK_SECRET
# Shared secret for verifying Mono webhook event payloads.

MONO_BASE_URL=https://api.withmono.com
# Mono base API URL.

# -----------------------------------------------------------------------------
# Termii — SMS OTP & Notifications
# -----------------------------------------------------------------------------
TERMII_API_KEY=REPLACE_WITH_TERMII_API_KEY
# Termii API key from the Dashboard → Developer → API Keys.

TERMII_SENDER_ID=NexCredit
# Approved alphanumeric sender ID registered on Termii.

TERMII_BASE_URL=https://api.ng.termii.com
# Termii base URL.

# -----------------------------------------------------------------------------
# Youverify / Dojah — BVN, NIN & Selfie KYC
# -----------------------------------------------------------------------------
YOUVERIFY_API_KEY=REPLACE_WITH_YOUVERIFY_API_KEY
# Youverify API key from the Developer Portal.

YOUVERIFY_BASE_URL=https://api.youverify.co
# Youverify base API URL.

DOJAH_APP_ID=REPLACE_WITH_DOJAH_APP_ID
# Dojah application ID from your account dashboard.

DOJAH_PRIVATE_KEY=REPLACE_WITH_DOJAH_PRIVATE_KEY
# Dojah private API key for server-side calls.

DOJAH_BASE_URL=https://sandbox.dojah.io
# Dojah base URL. Use https://api.dojah.io for production.

# -----------------------------------------------------------------------------
# CRC Credit Bureau
# -----------------------------------------------------------------------------
CRC_USERNAME=REPLACE_WITH_CRC_USERNAME
# CRC Credit Bureau username provided at onboarding.

CRC_PASSWORD=REPLACE_WITH_CRC_PASSWORD
# CRC Credit Bureau password.

CRC_BASE_URL=https://api.creditreportng.com
# CRC bureau API base URL.

CRC_SUBSCRIBER_ID=REPLACE_WITH_CRC_SUBSCRIBER_ID
# Subscriber/institution ID issued by CRC for report requests.

# -----------------------------------------------------------------------------
# FirstCentral Credit Bureau
# -----------------------------------------------------------------------------
FIRSTCENTRAL_USERNAME=REPLACE_WITH_FIRSTCENTRAL_USERNAME
# FirstCentral bureau account username.

FIRSTCENTRAL_PASSWORD=REPLACE_WITH_FIRSTCENTRAL_PASSWORD
# FirstCentral bureau account password.

FIRSTCENTRAL_BASE_URL=https://fcmb.firstcentralcreditbureau.com
# FirstCentral API base URL.

FIRSTCENTRAL_CLIENT_ID=REPLACE_WITH_FIRSTCENTRAL_CLIENT_ID
# Unique client identifier for FirstCentral API authentication.

# -----------------------------------------------------------------------------
# Google Cloud Storage (GCS) — KYC Documents & Agreements
# -----------------------------------------------------------------------------
GCS_BUCKET_NAME=nexcredit-kyc-documents-dev
# GCS bucket name where KYC documents and loan agreements are stored.

GCS_CREDENTIALS_PATH=/run/secrets/gcs_service_account.json
# Absolute path to the GCP service account JSON credentials file.
# In production, inject as a Docker secret or mount from GCP Secret Manager.

GCS_PROJECT_ID=REPLACE_WITH_GCP_PROJECT_ID
# GCP project ID that owns the storage bucket.

GCS_PRESIGNED_URL_TTL=900
# Pre-signed URL expiry in seconds for KYC document access (default: 15 minutes).

# -----------------------------------------------------------------------------
# AES-256 Field-Level Encryption
# -----------------------------------------------------------------------------
AES_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_HEX_KEY_64_CHARS_LONG
# 32-byte (256-bit) key used for AES-256-GCM encryption of PII fields (BVN, NIN, account numbers).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"

# -----------------------------------------------------------------------------
# Internal Service URLs (for inter-service communication)
# -----------------------------------------------------------------------------
IDENTITY_ENGINE_URL=http://identity_engine:8000/api/v1
RISK_ENGINE_URL=http://risk_engine:8002
LENDING_ENGINE_URL=http://lending_engine:8000/api/v1
PAYMENT_ENGINE_URL=http://payment_engine:8004
COLLECTIONS_ENGINE_URL=http://collections_engine:8005
NOTIFICATION_ENGINE_URL=http://notification_engine:8006
AI_ENGINE_URL=http://ai_engine:8007
COMPLIANCE_ENGINE_URL=http://compliance_engine:8008
CRM_ENGINE_URL=http://crm_engine:8009

# -----------------------------------------------------------------------------
# Lending Pool Config (Capital Limits)
# -----------------------------------------------------------------------------
MAX_LOAN_AMOUNT_NGN=25000
# Maximum single loan amount in Naira (FCCPC Phase 1 limit).

MAX_CAPITAL_CEILING=50000000
# Total outstanding portfolio ceiling in Naira. Disbursements blocked above this.

MAX_LOAN_TENOR_DAYS=30
# Maximum loan tenor in days (Phase 1 limit).

DEBUG_INCLUDE_OTP_IN_RESPONSE=false
